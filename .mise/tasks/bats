#!/usr/bin/env bash
#MISE description="Run BATS task-boundary tests (compatibility alias)"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" default="" var=#true help="Test suites or BATS arguments"
#USAGE example "mise run bats" header="Run all BATS tests through the canonical test task"
#USAGE example "mise run bats skeleton" header="Run a suite by name"
set -euo pipefail

arguments=()
if [ -n "${usage_args:-}" ]; then
  while IFS= read -r argument; do
    [ -z "$argument" ] || arguments+=("$argument")
  done < <(printf '%s' "$usage_args" | xargs printf '%s\n')
fi

exec mise run test ${arguments[@]+"${arguments[@]}"}
